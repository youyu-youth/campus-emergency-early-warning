# SQLite 数据库文件路径（相对项目根目录，默认 data/app.db）
DATABASE_PATH=data/app.db

# 真实模型接入（DeepSeek，OpenAI 兼容接口）；留空时推演使用模拟模型响应
# 换其他 OpenAI 兼容供应商：改 MODEL_BASE_URL 并配套改 MODEL_NAME
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# 兼容旧变量名（仅当 MODEL_API_KEY 未设置或为空时生效）
# DEEPSEEK_API_KEY=
